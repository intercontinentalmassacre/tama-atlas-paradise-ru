eep.png/revision/latest?cb=20230527052408","caption":"Спит","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:PsPatchipurinKiss.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e8/PsPatchipurinKiss.png/revision/latest?cb=20230527052359","caption":"Целуется","sprite":true}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":""}]}