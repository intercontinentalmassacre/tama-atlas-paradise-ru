File:TM2_4.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b2/TM2_4.jpeg/revision/latest/scale-to-width-down/320?cb=20210630092504","caption":"TM2 4.jpeg","large":"https://static.wikia.nocookie.net/tamagotchi/images/b/b2/TM2_4.jpeg/revision/latest?cb=20210630092504"},{"file":"https://tamagotchi.fandom.com/wiki/File:Gg919025.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/76/Gg919025.jpg/revision/latest/scale-to-width-down/320?cb=20230929234700","caption":"Happy.","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/76/Gg919025.jpg/revision/latest?cb=20230929234700"},{"file":"https://tamagotchi.fandom.com/wiki/File:Gg919029.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/9e/Gg919029.jpg/revision/latest/scale-to-width-down/320?cb=20230929234716","caption":"Happy.","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/9e/Gg919029.jpg/revision/latest?cb=20230929234716"},{"file":"https://tamagotchi.fandom.com/wiki/File:74689767-0020.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/c6/74689767-0020.png/revision/latest?cb=20181025140020","caption":"74689767-0020.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:Gg919037.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/70/Gg919037.jpg/revision/latest/scale-to-width-down/320?cb=20230924193823","caption":"Happy Принц.","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/70/Gg919037.jpg/revision/latest?cb=20230924193823"},{"file":"https://tamagotchi.fandom.com/wiki/File:Happy15th.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/80/Happy15th.png/revision/latest?cb=20160528153714","caption":"Happy15th.png"}],"related":[{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"}]}