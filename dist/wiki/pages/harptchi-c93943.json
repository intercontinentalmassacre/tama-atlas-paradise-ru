_sprite_friends.png/revision/latest?cb=20150118060707","caption":"Harptchi sprite friends.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Haputchi-sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/Haputchi-sprite.png/revision/latest?cb=20130808094629","caption":"Haputchi-sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Harptchimix.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/07/Harptchimix.png/revision/latest?cb=20180625033245","caption":"Harptchimix.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:Prettyprincesses.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/Prettyprincesses.jpg/revision/latest?cb=20130811025130","caption":"Prettyprincesses.jpg"},{"file":"https://tamagotchi.fandom.com/wiki/File:FCHarptchiScan.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3f/FCHarptchiScan.png/revision/latest?cb=20210923061000","caption":"FCHarptchiScan.png"}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-friends-fe748c","title":"Tamagotchi Friends","ru":"Tamagotchi Friends","kind":"device","note":""},{"id":"tamagotchi-friends-dream-town-digital-friend-bf6100","title":"Tamagotchi Friends: Dream Town Digital Friend","ru":"Tamagotchi Friends: Dream Town Digital Friend","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}