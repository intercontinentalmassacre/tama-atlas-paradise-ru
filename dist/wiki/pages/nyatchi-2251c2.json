/tamagotchi/images/4/4b/28.NyatchiFront.jpeg/revision/latest/scale-to-width-down/320?cb=20221107232744","caption":"Nyatchi (Передняя часть)","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/4b/28.NyatchiFront.jpeg/revision/latest?cb=20221107232744"},{"file":"https://tamagotchi.fandom.com/wiki/File:28.NyatchiBack.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d6/28.NyatchiBack.jpeg/revision/latest/scale-to-width-down/320?cb=20221107232855","caption":"Nyatchi (Сзади)","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d6/28.NyatchiBack.jpeg/revision/latest?cb=20221107232855"},{"src":"gallery-assets/img/84/843ffc88dec18d23231e.webp","file":"https://tamagotchi.fandom.com/wiki/File:Card_TMGC01-027.jpg","caption":"Tamagotchi Paradise Карточка счастливой коллекции 027"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_anim_gen2.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/69/Nyatchi_anim_gen2.gif/revision/latest?cb=20181014132439","caption":"Анимированный спрайт (оригинал Tamagotchi, поколение 2)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_Close_Up_V3.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/dd/Nyatchi_Close_Up_V3.png/revision/latest?cb=20240718143513","caption":"Крупный план (Соединение V3)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_TamaConnect_%2724_close-up.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/da/Nyatchi_TamaConnect_%2724_close-up.png/revision/latest?cb=20250616151523","caption":"Крупный план (Связь 2024)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_Hoshi_De_Hakken.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/cc/Nyatchi_Hoshi_De_Hakken.png/revision/latest?cb=20210201233315","caption":"Nyatchi Hoshi De Hakken.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_sprite_SNES.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d6/Nyatchi_sprite_SNES.png/revision/latest?cb=20160107042244","caption":"Спрайт внешнего мира из города Tamagotchi (игра SFC)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_ttbio.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/43/Nyatchi_ttbio.png/revision/latest?cb=20180611194835","caption":"Спрайт профиля из Tamagotchi Town (SFC Game)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Adult-Nyatchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/fc/Adult-Nyatchi.PNG/revision/latest?cb=20110917023708","caption":"Adult-Nyatchi.PNG"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nyatchi_Connection2024_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3f/Nyatchi_Connection2024_sprite.png/revision/latest?cb=20240926145402","caption":"Nyatchi Connection2024 sprite.png","sprite":true},{"src":"gallery-assets/img/ae/ae727119ca56e6f53969.webp","file":"https://tamagotchi.fandom.com/wiki/File:Takonyatchi_Paradise.png","caption":"Tamagotchi Paradise"},{"file":"https://tamagotchi.fandom.com/wiki/File:Doronekotchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/Doronekotchi.png/revision/latest?cb=20141129111809","caption":"Doronekotchi.png"}],"related":[{"id":"tamagotchi-1996-pet-27258f","title":"Tamagotchi (1996 Pet)","ru":"Тамагочи (1996)","kind":"device","note":""},{"id":"tamagotchi-connection-2024-8f9f9f","title":"Tamagotchi Connection (2024)","ru":"Tamagotchi Connection (2024)","kind":"device","note":""},{"id":"tamagotchi-connection-version-3-1fa36d","title":"Tamagotchi Connection Version 3","ru":"Tamagotchi Connection Version 3","kind":"device","note":""}]}