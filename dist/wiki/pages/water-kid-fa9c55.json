)"},{"src":"gallery-assets/img/ec/ec1532e99496985cbd72.webp","file":"https://tamagotchi.fandom.com/wiki/File:DJABBIC13_EndCard.png","caption":"Кадр · Sharktchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:WaterKid_small_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/37/WaterKid_small_sprite.png/revision/latest?cb=20250724205741","caption":"Вид поля","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:WaterKid_Paradise_sprite_sleep.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/97/WaterKid_Paradise_sprite_sleep.png/revision/latest?cb=20250813205248","caption":"Спит","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:WaterKid_Paradise_sprite_death.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/21/WaterKid_Paradise_sprite_death.png/revision/latest?cb=20250813210000","caption":"Умирает","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:WaterKid_Paradise_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/WaterKid_Paradise_sprite.png/revision/latest?cb=20250722215822","caption":"WaterKid Paradise sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Water_Kid.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/dc/Water_Kid.png/revision/latest/scale-to-width-down/320?cb=20250521155518","caption":"Water Kid.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/dc/Water_Kid.png/revision/latest?cb=20250521155518"}],"related":[{"id":"tamagotchi-paradise-cd150b","title":"Tamagotchi Paradise","ru":"Tamagotchi Paradise","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"камео"}]}