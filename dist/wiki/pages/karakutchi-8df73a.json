_06-54-45-750.jpg/revision/latest?cb=20181218120406"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-18_06-55-30-462.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/ea/Bandicam_2018-12-18_06-55-30-462.jpg/revision/latest/scale-to-width-down/320?cb=20181218120421","caption":"Bandicam 2018-12-18 06-55-30-462.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/ea/Bandicam_2018-12-18_06-55-30-462.jpg/revision/latest?cb=20181218120421"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-12-18_08-37-17-346.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/2c/Bandicam_2019-12-18_08-37-17-346.png/revision/latest/scale-to-width-down/320?cb=20191218134322","caption":"Bandicam 2019-12-18 08-37-17-346.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/2c/Bandicam_2019-12-18_08-37-17-346.png/revision/latest?cb=20191218134322"}],"related":[{"id":"tamagotchi-friends-dream-town-digital-friend-bf6100","title":"Tamagotchi Friends: Dream Town Digital Friend","ru":"Tamagotchi Friends: Dream Town Digital Friend","kind":"device","note":""},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""}]}