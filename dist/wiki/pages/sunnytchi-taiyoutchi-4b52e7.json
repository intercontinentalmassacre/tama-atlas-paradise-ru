нии · Суннитчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/92/OFC7_Sunnytchi.png/revision/latest?cb=20260103050919"},{"file":"https://tamagotchi.fandom.com/wiki/File:Card_TMGC01-009_Back.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/90/Card_TMGC01-009_Back.jpeg/revision/latest/scale-to-width-down/320?cb=20251009011621","caption":"Tamagotchi Paradise Карточка Happy Collection 009 (обратная сторона)","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/90/Card_TMGC01-009_Back.jpeg/revision/latest?cb=20251009011621"},{"file":"https://tamagotchi.fandom.com/wiki/File:SunnytchiLight_Uni_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/SunnytchiLight_Uni_sprite.png/revision/latest?cb=20250808154022","caption":"Световая мебель Sunnytchi (Uni)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Sunnytchi_m!x_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/70/Sunnytchi_m%21x_sprite.png/revision/latest?cb=20250804151757","caption":"Игровой спрайт · Sunnytchi (Taiyoutchi)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Sunnytchi_4U_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3b/Sunnytchi_4U_sprite.png/revision/latest?cb=20250813143307","caption":"Игровой спрайт · Sunnytchi (Taiyoutchi)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:SunnytchiONSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f2/SunnytchiONSprite.png/revision/latest?cb=20220701040545","caption":"Игровой спрайт · Sunnytchi (Taiyoutchi)","sprite":true}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id