/PopuotohimetchiSprite.png/revision/latest?cb=20220727044541","caption":"Поп Otohimetchi (Умный)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:NamiPoptchiSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/fb/NamiPoptchiSprite.png/revision/latest?cb=20241028163418","caption":"Нами Poptchi (Умная)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:DJPoptchiSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/59/DJPoptchiSprite.png/revision/latest?cb=20250318200101","caption":"DJ Poptchi (Умный)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:PopPierrotchiSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/9e/PopPierrotchiSprite.png/revision/latest?cb=20220909015533","caption":"Поп Pierrotchi (Умный)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:JessiePoptchiSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/18/JessiePoptchiSprite.png/revision/latest?cb=20230211045530","caption":"Джесси Poptchi (Умный)","sprite":true},{"src":"gallery-assets/img/06/0644b9134e391f8c4ee8.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiDotsSmartKeychain.PNG","caption":"Tamagotchi Брелок в виде точек"},{"src":"gallery-assets/img/69/6961c59139ce2e29f457.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiDotsSmartRubber.PNG","caption":"Tamagotchi Каучуковый ремешок в горошек"},{"src":"gallery-assets/img/ad/ad8a5b7b1e547bffc5cf.webp","file":"https://tamagotchi.fandom.com/wiki/File:MyTamagotchiForeverSmart.PNG","caption":"Появление в My Tamagotchi Forever (только версия для Японии)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Poptchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/Poptchi_sprite.png/revision/latest?cb=20220817184331","caption":"Poptchi sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Poptchi_MametchiMemories_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/45/Poptchi_MametchiMemories_sprite.png/revision/latest?cb=20261027161907","caption":"Poptchi MametchiMemories sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MelodyPopArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7a/MelodyPopArtwork.png/revision/latest/scale-to-width-down/320?cb=20220513174625","caption":"MelodyPopArtwork.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7a/MelodyPopArtwork.png/revision/latest?cb=20220513174625"},{"file":"https://tamagotchi.fandom.com/wiki/File:PopOtohimetchiArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/PopOtohimetchiArtwork.png/revision/latest/scale-to-width-down/320?cb=20221028045541","caption":"PopOtohimetchiArtwork.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/PopOtohimetchiArtwork.png/revision/latest?cb=20221028045541"},{"file":"https://tamagotchi.fandom.com/wiki/File:NamiPoptchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/ab/NamiPoptchi.png/revision/latest/scale-to-width-down/320?cb=20220615184040","caption":"NamiPoptchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/ab/NamiPoptchi.png/revision/latest?cb=20220615184040"},{"file":"https://tamagotchi.fandom.com/wiki/File:DJPoptchiArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/DJPoptchiArtwork.png/revision/latest/scale-to-width-down/320?cb=20221028052314","caption":"DJPoptchiArtwork.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/DJPoptchiArtwork.png/revision/latest?cb=20221028052314"},{"file":"https://tamagotchi.fandom.com/wiki/File:PopPierrotchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/12/PopPierrotchi.png/revision/latest/scale-to-width-down/320?cb=20221029044941","caption":"PopPierrotchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/12/PopPierrotchi.png/revision/latest?cb=20221029044941"},{"file":"https://tamagotchi.fandom.com/wiki/File:JessiePoptchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7b/JessiePoptchi.png/revision/latest/scale-to-width-down/320?cb=20221124054137","caption":"JessiePoptchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7b/JessiePoptchi.png/revision/latest?cb=20221124054137"},{"file":"https://tamagotchi.fandom.com/wiki/File:Poptchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/1a/Poptchi.png/revision/latest/scale-to-width-down/320?cb=20210618041725","caption":"Poptchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/1a/Poptchi.png/revision/latest?cb=20210618041725"}],"related":[{"id":"tamagotchi-nano-colorful-mametchi-memories-c351a3","title":"Tamagotchi Nano Colorful: Mametchi Memories","ru":"Tamagotchi Nano Colorful: Mametchi Memories","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":""}]}