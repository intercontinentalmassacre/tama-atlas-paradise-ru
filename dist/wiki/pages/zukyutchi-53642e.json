tchi/images/e/ea/OnionZukyuPorkBun.jpeg/revision/latest?cb=20221026134313"},{"file":"https://tamagotchi.fandom.com/wiki/File:ZukyutchiCloseupConnection.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a5/ZukyutchiCloseupConnection.gif/revision/latest?cb=20260420211928","caption":"Крупный план (от Entama до Connection V4)"},{"file":"https://tamagotchi.fandom.com/wiki/File:ZukyutchiBroomSmartSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/14/ZukyutchiBroomSmartSprite.png/revision/latest?cb=20221206040636","caption":"Спрайт анимации предмета «Уборочное оборудование» (умный)","sprite":true},{"src":"gallery-assets/img/d4/d42ddc2fe98ec5d5b88d.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiSchoolFigureSet.jpg","caption":"Tamagotchi School набор фигурок"},{"file":"https://tamagotchi.fandom.com/wiki/File:Zukyutchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3f/Zukyutchi_sprite.png/revision/latest?cb=20130923134241","caption":"Zukyutchi sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Ura_Zukyutchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/Ura_Zukyutchi.png/revision/latest/scale-to-width-down/320?cb=20200922233750","caption":"Ura Zukyutchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/Ura_Zukyutchi.png/revision/latest?cb=20200922233750"}],"related":[{"id":"chou-jinsei-enjoi-tamagotchi-plus-7ac1c9","title":"Chou Jinsei Enjoi Tamagotchi Plus","ru":"Chou Jinsei Enjoi Tamagotchi Plus","kind":"device","note":""},{"id":"tamagotchi-connection-version-4-ad1b87","title":"Tamagotchi Connection Version 4","ru":"Tamagotchi Connection Version 4","kind":"device","note":""},{"id":"tamagotchi-music-star-89a6a2","title":"Tamagotchi Music Star","ru":"Tamagotchi Music Star","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":"го