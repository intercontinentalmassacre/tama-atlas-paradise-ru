патчи Чонсам.","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7a/Gg918962.jpg/revision/latest?cb=20230920181438"},{"file":"https://tamagotchi.fandom.com/wiki/File:G75675675.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/1f/G75675675.png/revision/latest?cb=20181019195534","caption":"Молодая одежда Кучипатчи Чонсам."},{"file":"https://tamagotchi.fandom.com/wiki/File:Card_TMGC01-033.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/Card_TMGC01-033.jpeg/revision/latest/scale-to-width-down/320?cb=20251009005222","caption":"Тамагочи Рай Счастливая Коллекция Карта 033","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/Card_TMGC01-033.jpeg/revision/latest?cb=20251009005222"},{"file":"https://tamagotchi.fandom.com/wiki/File:Young_kuchipatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/23/Young_kuchipatchi.png/revision/latest?cb=20140811192251","caption":"Young kuchipatchi.png"}],"related":[{"id":"chou-jinsei-enjoi-tamagotchi-plus-7ac1c9","title":"Chou Jinsei Enjoi Tamagotchi Plus","ru":"Chou Jinsei Enjoi Tamagotchi Plus","kind":"device","note":""},{"id":"tamagotchi-connection-version-4-ad1b87","title":"Tamagotchi Connection Version 4","ru":"Tamagotchi Connection Version 4","kind":"device","note":""},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""}]}