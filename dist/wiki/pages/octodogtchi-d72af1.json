.com/wiki/File:S2E34_DanceTeam.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/68/S2E34_DanceTeam.png/revision/latest/scale-to-width-down/320?cb=20210809181749","caption":"Сезон 2, серия 34","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/68/S2E34_DanceTeam.png/revision/latest?cb=20210809181749"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-08-12_00-06-10-930.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/Bandicam_2018-08-12_00-06-10-930.jpg/revision/latest/scale-to-width-down/320?cb=20181005071748","caption":"Снимок экрана · Октодогтчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/Bandicam_2018-08-12_00-06-10-930.jpg/revision/latest?cb=20181005071748"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-19-14-299.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0b/Bandicam_2018-10-14_21-19-14-299.jpg/revision/latest/scale-to-width-down/320?cb=20181015014525","caption":"Снимок экрана · Октодогтчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0b/Bandicam_2018-10-14_21-19-14-299.jpg/revision/latest?cb=20181015014525"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-39-31-000.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/db/Bandicam_2018-10-14_21-39-31-000.jpg/revision/latest/scale-to-width-down/320?cb=20181015015346","caption":"Снимок экрана · Октодогтчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/db/Bandicam_2018-10-14_21-39-31-000.jpg/revision/latest?cb=20181015015346"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-43-46-300.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/6f/Bandicam_2018-10-14_21-43-46-300.jpg/revision/latest/scale-to-width-down/320?cb=20181015015531","caption":"Снимок экрана · Октодогтчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/6f/Bandicam_2018-10-14_21-43-4