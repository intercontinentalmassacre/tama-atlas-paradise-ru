:"https://static.wikia.nocookie.net/tamagotchi/images/b/b1/V5.5_Uranaitchi.png/revision/latest?cb=20110914093015","caption":"На изображении · Уранаитчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:ID_Uranaitchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/81/ID_Uranaitchi.PNG/revision/latest?cb=20110914083200","caption":"На изображении · Уранаитчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:UranaitchiMixSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/UranaitchiMixSprite.png/revision/latest?cb=20220715041758","caption":"Игровой спрайт · Уранаитчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Uranaitchi_Meets_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/33/Uranaitchi_Meets_sprite.png/revision/latest?cb=20250130180016","caption":"Игровой спрайт · Уранаитчи","sprite":true}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-connection-version-5-celebrity-071dde","title":"Tamagotchi Connection Version 5 Celebrity","ru":"Tamagotchi Connection Version 5 Celebrity","kind":"device","note":""},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"камео"},{"id":"tamagotchi-id-d4b2f3","title":"Tamagotchi iD","ru":"Tamagotchi iD","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}