://tamagotchi.fandom.com/wiki/File:Tamagotchi_Connection_-_CS1_dododotchi_happy.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/85/Tamagotchi_Connection_-_CS1_dododotchi_happy.png/revision/latest?cb=20230322213012","caption":"Радуется","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Tamagotchi_Connection_-_CS1_dododotchi_sad.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/69/Tamagotchi_Connection_-_CS1_dododotchi_sad.png/revision/latest?cb=20230322213126","caption":"Грустит","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Tamagotchi_Connection_-_CS1_dododotchi_angry.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/bd/Tamagotchi_Connection_-_CS1_dododotchi_angry.png/revision/latest?cb=20230322213158","caption":"Сердится","sprite":true}],"related":[{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-paradise-cd150b","title":"Tamagotchi Paradise","ru":"Tamagotchi Paradise","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-plus-color-87834e","title":"Tamagotchi Plus Color","ru":"Tamagotchi Plus Color","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"}]}