08-347.jpg/revision/latest/scale-to-width-down/320?cb=20181010011327","caption":"Bandicam 2018-10-09 20-56-08-347.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/81/Bandicam_2018-10-09_20-56-08-347.jpg/revision/latest?cb=20181010011327"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-05_19-11-42-290.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/66/Bandicam_2018-10-05_19-11-42-290.jpg/revision/latest/scale-to-width-down/320?cb=20181121082441","caption":"Bandicam 2018-10-05 19-11-42-290.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/66/Bandicam_2018-10-05_19-11-42-290.jpg/revision/latest?cb=20181121082441"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-19_22-20-07-915.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/cc/Bandicam_2018-10-19_22-20-07-915.jpg/revision/latest/scale-to-width-down/320?cb=20190313031656","caption":"Bandicam 2018-10-19 22-20-07-915.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/cc/Bandicam_2018-10-19_22-20-07-915.jpg/revision/latest?cb=20190313031656"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2020-04-04_13-49-24-947.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/9f/Bandicam_2020-04-04_13-49-24-947.png/revision/latest/scale-to-width-down/320?cb=20200404175618","caption":"Bandicam 2020-04-04 13-49-24-947.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/9f/Bandicam_2020-04-04_13-49-24-947.png/revision/latest?cb=20200404175618"},{"file":"https://tamagotchi.fandom.com/wiki/File:Tamagotchi!_Yume_Kira_Dream_Episode_025_1464763.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/52/Tamagotchi%21_Yume_Kira_Dream_Episode_025_1464763.jpg/revision/latest/scale-to-width-down/320?cb=20200616153507","caption":"Tamagotchi! Yume Kira Dream Episode 025 1464763.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/52/Tamagotchi%21_Yu