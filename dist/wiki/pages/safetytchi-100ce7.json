-54-090.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/ef/Bandicam_2018-10-13_04-53-54-090.jpg/revision/latest/scale-to-width-down/320?cb=20181013090855","caption":"Радость Safetytchi крупным планом.","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/ef/Bandicam_2018-10-13_04-53-54-090.jpg/revision/latest?cb=20181013090855"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-27_07-00-03-065.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a4/Bandicam_2018-12-27_07-00-03-065.png/revision/latest/scale-to-width-down/320?cb=20181227120100","caption":"Bandicam 2018-12-27 07-00-03-065.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a4/Bandicam_2018-12-27_07-00-03-065.png/revision/latest?cb=20181227120100"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-09-06_00-37-38-958.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/Bandicam_2018-09-06_00-37-38-958.jpg/revision/latest/scale-to-width-down/320?cb=20181005085207","caption":"В одной из открывающих тем","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/Bandicam_2018-09-06_00-37-38-958.jpg/revision/latest?cb=20181005085207"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-27_06-32-18-665.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/78/Bandicam_2018-12-27_06-32-18-665.png/revision/latest/scale-to-width-down/320?cb=20181227113906","caption":"Bandicam 2018-12-27 06-32-18-665.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/78/Bandicam_2018-12-27_06-32-18-665.png/revision/latest?cb=20181227113906"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-27_07-02-38-930.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3d/Bandicam_2018-12-27_07-02-38-930.png/revision/latest/scale-to-width-down/320?cb=20181227122234","caption":"Bandicam 2018-12-27 07-02-38-930.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/3d/Bandicam_2018-12-27_07-02-38-930.png/revision/latest?cb=20181227122234"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-27_07-10-38-787.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/8a/Bandicam_2018-12-27_07-10-38-787.png/revision/latest/scale-to-width-down/320?cb=20181227122324","caption":"Bandicam 2018-12-27 07-10-38-787.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/8a/Bandicam_2018-12-27_07-10-38-787.png/revision/latest?cb=20181227122324"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-12-27_07-21-20-789.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a7/Bandicam_2018-12-27_07-21-20-789.png/revision/latest/scale-to-width-down/320?cb=20181227122455","caption":"Bandicam 2018-12-27 07-21-20-789.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a7/Bandicam_2018-12-27_07-21-20-789.png/revision/latest?cb=20181227122455"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-05_01-58-04-095.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f6/Bandicam_2019-06-05_01-58-04-095.png/revision/latest/scale-to-width-down/320?cb=20190606045816","caption":"Bandicam 2019-06-05 01-58-04-095.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f6/Bandicam_2019-06-05_01-58-04-095.png/revision/latest?cb=20190606045816"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-18_13-03-13-252.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/8b/Bandicam_2019-06-18_13-03-13-252.png/revision/latest/scale-to-width-down/320?cb=20190618170603","caption":"Bandicam 2019-06-18 13-03-13-252.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/8b/Bandicam_2019-06-18_13-03-13-252.png/revision/latest?cb=20190618170603"}],"related":[]}