om.com/wiki/File:Bandicam_2019-06-18_17-09-01-918.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/df/Bandicam_2019-06-18_17-09-01-918.png/revision/latest/scale-to-width-down/320?cb=20190618212227","caption":"Bandicam 2019-06-18 17-09-01-918.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/df/Bandicam_2019-06-18_17-09-01-918.png/revision/latest?cb=20190618212227"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-18_17-16-01-986.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/00/Bandicam_2019-06-18_17-16-01-986.png/revision/latest/scale-to-width-down/320?cb=20190618212255","caption":"Bandicam 2019-06-18 17-16-01-986.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/00/Bandicam_2019-06-18_17-16-01-986.png/revision/latest?cb=20190618212255"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-06-23-154.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5e/Bandicam_2018-10-14_21-06-23-154.jpg/revision/latest/scale-to-width-down/320?cb=20181015155756","caption":"Bandicam 2018-10-14 21-06-23-154.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5e/Bandicam_2018-10-14_21-06-23-154.jpg/revision/latest?cb=20181015155756"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-07-07-842.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f8/Bandicam_2018-10-14_21-07-07-842.jpg/revision/latest/scale-to-width-down/320?cb=20181015155809","caption":"Bandicam 2018-10-14 21-07-07-842.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f8/Bandicam_2018-10-14_21-07-07-842.jpg/revision/latest?cb=20181015155809"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-14_21-08-19-181.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5f/Bandicam_2018-10-14_21-08-19-181.jpg/revision/latest/scale-to-width-down/320?cb=20181015155832","caption":"Bandicam 2018-10-14