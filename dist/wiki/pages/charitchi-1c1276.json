hi/images/1/1a/QCHAR.BIN%28408%29_p00.png/revision/latest?cb=20210205001946","caption":"QCHAR.BIN(408) p00.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:CharitchiHoshiDeHakken.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/cf/CharitchiHoshiDeHakken.gif/revision/latest?cb=20220625161745","caption":"Анимированный спрайт от Хоши де Хаккена!! Tamagotchi","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Charitchi_sprite_SNES.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/31/Charitchi_sprite_SNES.png/revision/latest?cb=20160109044007","caption":"Спрайт окружающего мира в городе Tamagotchi (игра SFC)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Charitchi_ttbio.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a0/Charitchi_ttbio.png/revision/latest?cb=20180611194900","caption":"Спрайт профиля в городе Tamagotchi (игра SFC)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Charitchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e0/Charitchi_sprite.png/revision/latest?cb=20130906094254","caption":"Charitchi sprite.png","sprite":true}],"related":[{"id":"tamagotchi-1996-pet-27258f","title":"Tamagotchi (1996 Pet)","ru":"Тамагочи (1996)","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"камео"}]}