es/b/b5/JoouSamaMixSprite.png/revision/latest?cb=20220715041757","caption":"Игровой спрайт · Queen of Melody Land","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:1296468303412.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a9/1296468303412.jpg/revision/latest/scale-to-width-down/320?cb=20110405053107","caption":"Из альбома «Queen of Melody Land» · № 19","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a9/1296468303412.jpg/revision/latest?cb=20110405053107"}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}