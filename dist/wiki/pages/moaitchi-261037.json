":"https://tamagotchi.fandom.com/wiki/File:P2_WhitePattern.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/P2_WhitePattern.jpg/revision/latest/scale-to-width-down/320?cb=20181029211253","caption":"На снаряде Tamagotchi P2","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/P2_WhitePattern.jpg/revision/latest?cb=20181029211253"},{"file":"https://tamagotchi.fandom.com/wiki/File:Nakama.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7d/Nakama.jpg/revision/latest/scale-to-width-down/320?cb=20200729151222","caption":"Рулонная бумага для печати","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7d/Nakama.jpg/revision/latest?cb=20200729151222"},{"file":"https://tamagotchi.fandom.com/wiki/File:Placeholder.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/Placeholder.png/revision/latest/scale-to-width-down/320?cb=20250427114146","caption":"Placeholder.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/Placeholder.png/revision/latest?cb=20250427114146"},{"file":"https://tamagotchi.fandom.com/wiki/File:Hellotchi_Moaitchi_m!x_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/56/Hellotchi_Moaitchi_m%21x_sprite.png/revision/latest?cb=20251007180113","caption":"Hellotchi Moaitchi m!x sprite.png","sprite":true}],"related":[{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"камео"}]}