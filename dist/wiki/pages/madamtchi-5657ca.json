ps://static.wikia.nocookie.net/tamagotchi/images/c/c8/GGT41A_1.jpeg/revision/latest?cb=20210626101532"},{"file":"https://tamagotchi.fandom.com/wiki/File:Madamutchi_Sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d1/Madamutchi_Sprite.png/revision/latest?cb=20130817001438","caption":"Madamutchi Sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MadamtchiMixSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/ac/MadamtchiMixSprite.png/revision/latest?cb=20220713172315","caption":"MadamtchiMixSprite.png","sprite":true}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}