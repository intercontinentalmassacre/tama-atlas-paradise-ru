e":"https://static.wikia.nocookie.net/tamagotchi/images/1/1a/Tamagotchi-nnc-dsjapan_princess_tamakoko-stand.gif/revision/latest?cb=20181030181730","caption":"На изображении · Tamago"},{"file":"https://tamagotchi.fandom.com/wiki/File:V5.5_tamakoko.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/V5.5_tamakoko.png/revision/latest?cb=20111021100250","caption":"Из альбома «Princess Tamakoko» · № 23"},{"file":"https://tamagotchi.fandom.com/wiki/File:Princess_Tamakoko15th.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b6/Princess_Tamakoko15th.png/revision/latest?cb=20260812162253","caption":"Из альбома «Princess Tamakoko» · № 24"},{"file":"https://tamagotchi.fandom.com/wiki/File:Princess_Tamakoko_4U_Sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/ec/Princess_Tamakoko_4U_Sprite.png/revision/latest?cb=20240125083116","caption":"Игровой спрайт · Princess Tamakoko","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamakokoMeetsSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/44/TamakokoMeetsSprite.png/revision/latest?cb=20220713172315","caption":"Игровой спрайт · Princess Tamakoko","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Gotchi_king.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/75/Gotchi_king.PNG/revision/latest/scale-to-width-down/320?cb=20200818050422","caption":"Современная версия","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/75/Gotchi_king.PNG/revision/latest?cb=20200818050422"},{"file":"https://tamagotchi.fandom.com/wiki/File:GotchiQueen.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e3/GotchiQueen.png/revision/latest/scale-to-width-down/320?cb=20211219212630","caption":"Современная версия","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/e3/GotchiQueen.png/revision/latest?cb=20211219212630"},{"file":"https://tamagotchi.fandom.com/wiki/File:Princess_Tamako.PNG