ng","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/68/CameratchiSprite.png/revision/latest?cb=20220819051833","caption":"CameratchiSprite.png","sprite":true}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"}]}