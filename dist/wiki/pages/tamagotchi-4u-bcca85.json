ookie.net/tamagotchi/images/1/1d/4u%2B_pearl_pink.jpg/revision/latest/scale-to-width-down/320?cb=20151220175049","caption":"4u+ pearl pink.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/1d/4u%2B_pearl_pink.jpg/revision/latest?cb=20151220175049"},{"file":"https://tamagotchi.fandom.com/wiki/File:4u%2B_pearl_purple.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/44/4u%2B_pearl_purple.jpg/revision/latest/scale-to-width-down/320?cb=20151220175100","caption":"4u+ pearl purple.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/44/4u%2B_pearl_purple.jpg/revision/latest?cb=20151220175100"}],"related":[{"id":"airoutchi-74dcb6","title":"Airoutchi","ru":"Аиротчи","kind":"character","note":"загружаемый контент"},{"id":"akari-chan-tchi-e58228","title":"Akari-chan-tchi","ru":"Акари-чан-тчи","kind":"character","note":""},{"id":"akaspetchi-ace472","title":"Akaspetchi","ru":"Акаспэтчи","kind":"character","note":"гость (NPC)"},{"id":"anemoriritchi-537b94","title":"Anemoriritchi","ru":"Анэмориритчи","kind":"character","note":"гость (NPC)"},{"id":"antoinetchi-5413c6","title":"Antoinetchi","ru":"Антоинэтчи","kind":"character","note":"загружаемый контент"},{"id":"artistchi-50495e","title":"Artistchi","ru":"Артистчи","kind":"character","note":"гость (NPC)"},{"id":"arukumatchi-38e800","title":"Arukumatchi","ru":"Арукуматчи","kind":"character","note":"загружаемый контент"},{"id":"auction-ojitchi-f6eb08","title":"Auction Ojitchi","ru":"Auction Ojitchi","kind":"character","note":"гость (NPC)"},{"id":"baritchi-c1e99a","title":"Baritchi","ru":"Баритчи","kind":"character","note":"загружаемый контент"},{"id":"beartchi-fdd461","title":"Beartchi","ru":"Бэартчи","kind":"character","note":"гость (NPC)"},{"id":"bouquetchi-6a8b91","title":"Bouquetchi","ru":"Боквэтчи","kind":"character","note":"загружаемый контент"},{"id":"candy-pakupaku-4700c3","title":"Candy Pakupaku","ru":"Candy Pakupaku","kind":"character","note":""},{"id":"chamametchi-3b5dc3