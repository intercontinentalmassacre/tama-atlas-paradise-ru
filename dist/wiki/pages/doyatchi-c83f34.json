caption":"Бритая Дойя (P)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Doyatchi_Friends_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/05/Doyatchi_Friends_sprite.png/revision/latest?cb=20170808051835","caption":"Игровой спрайт · Доятчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Doyatchi_Sprite_(Tamagotchi_P%27s).png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/01/Doyatchi_Sprite_%28Tamagotchi_P%27s%29.png/revision/latest?cb=20130916054056","caption":"Игровой спрайт · Доятчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:DCDoyatchiScan.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/01/DCDoyatchiScan.png/revision/latest?cb=20210923062009","caption":"Скан иллюстрации · Доятчи"}],"related":[{"id":"tamagotchi-friends-dream-town-digital-friend-bf6100","title":"Tamagotchi Friends: Dream Town Digital Friend","ru":"Tamagotchi Friends: Dream Town Digital Friend","kind":"device","note":""},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""}]}