enshitchiChopsticksSet.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/TenshitchiChopsticksSet.png/revision/latest/scale-to-width-down/320?cb=20230227025349","caption":"Набор палочек для еды","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/11/TenshitchiChopsticksSet.png/revision/latest?cb=20230227025349"},{"file":"https://tamagotchi.fandom.com/wiki/File:MarutchiAngel_Sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/c9/MarutchiAngel_Sprite.png/revision/latest?cb=20140404033558","caption":"Игровой спрайт · Marutchi Angel","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MarutchiAngel_2024_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/12/MarutchiAngel_2024_sprite.png/revision/latest?cb=20250529145710","caption":"Игровой спрайт · Marutchi Angel","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MarutchiAngel_sprite_SNES.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/02/MarutchiAngel_sprite_SNES.png/revision/latest?cb=20160201043830","caption":"Игровой спрайт · Marutchi Angel","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiParkMarutchiAngel.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/cb/TamagotchiParkMarutchiAngel.png/revision/latest?cb=20230711013708","caption":"Персонажи на изображении · Tamago, Марутчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:MarutchiAngelSprite_App.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/09/MarutchiAngelSprite_App.png/revision/latest?cb=20140404032719","caption":"Игровой спрайт · Marutchi Angel","sprite":true}],"related":[{"id":"tamagotchi-angel-f944e3","title":"Tamagotchi Angel","ru":"Tamagotchi Angel","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"}]}