/3f/IDLSquirrelMeister.png/revision/latest?cb=20250501215138","caption":"Рисурису Мейстер (15 лет iD L)"},{"file":"https://tamagotchi.fandom.com/wiki/File:SquirrelMeisterSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/00/SquirrelMeisterSprite.png/revision/latest?cb=20250501215127","caption":"Рисурису Мейстер, крупный план (15-летие iD L)","sprite":true},{"src":"gallery-assets/img/49/49de397c6604eb46e6e0.webp","file":"https://tamagotchi.fandom.com/wiki/File:JiyuchoNaturalPattermNotebook.jpg","caption":"Натуральный блокнот"},{"src":"gallery-assets/img/69/69aff778426515417767.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamamoriArtMori.jpg","caption":"Арт-Мори"},{"src":"gallery-assets/img/f6/f66d31bf46f1c3585d55.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamamoriDaisukeMori.jpg","caption":"Дайсуке Мори"},{"file":"https://tamagotchi.fandom.com/wiki/File:PapaMystartchi_Meets_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/31/PapaMystartchi_Meets_sprite.png/revision/latest?cb=20250501203332","caption":"Отец Mystartchi (m!x и Meets)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MamaMystartchi_Meets_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/MamaMystartchi_Meets_sprite.png/revision/latest?cb=20250501203354","caption":"Мать Mystartchi (m!x и Meets)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Maisutatchi_nano.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/23/Maisutatchi_nano.png/revision/latest?cb=20141216205909","caption":"Maisutatchi nano.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:15Maisutaatchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5d/15Maisutaatchi.PNG/revision/latest?cb=20110907002822","caption":"15Maisutaatchi.PNG"},{"file":"https://tamagotchi.fandom.com/wiki/File:Maisumix.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a3/Maisumix.png/revision/latest?cb=20250221201503","caption":"Maisumix.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:Mystartchi_Uni_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d4/Mystartchi_Uni_sprite.png/revision/latest?cb=20240603162323","caption":"Mystartchi Uni sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:SquirrelMeisterArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/ec/SquirrelMeisterArtwork.png/revision/latest?cb=20210821034940","caption":"SquirrelMeisterArtwork.png"}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-nano-b2d6a2","title":"Tamagotchi Nano","ru":"Tamagotchi Nano","kind":"device","note":""},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":""},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}