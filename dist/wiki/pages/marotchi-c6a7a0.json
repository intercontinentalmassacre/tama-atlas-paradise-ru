tchi Plus","kind":"device","note":""},{"id":"tamatown-tama-go-ef5dce","title":"TamaTown Tama-Go","ru":"TamaTown Tama-Go","kind":"device","note":""},{"id":"tamagotchi-connection-version-4-ad1b87","title":"Tamagotchi Connection Version 4","ru":"Tamagotchi Connection Version 4","kind":"device","note":""},{"id":"tamagotchi-plus-color-87834e","title":"Tamagotchi Plus Color","ru":"Tamagotchi Plus Color","kind":"device","note":""},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":"гость (NPC)"}]}