tatic.wikia.nocookie.net/tamagotchi/images/c/cb/MameKittyKiss.png/revision/latest?cb=20230523013920","caption":"Целуется","sprite":true}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":""}]}