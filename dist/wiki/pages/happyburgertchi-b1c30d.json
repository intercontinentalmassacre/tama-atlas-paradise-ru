":"https://static.wikia.nocookie.net/tamagotchi/images/4/46/Happyburgertchi_sprite_on.png/revision/latest?cb=20200907011952","caption":"Игровой спрайт · Хаппибургэртчи","sprite":true}],"related":[{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-paradise-cd150b","title":"Tamagotchi Paradise","ru":"Tamagotchi Paradise","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-d4b2f3","title":"Tamagotchi iD","ru":"Tamagotchi iD","kind":"device","note":"гость (NPC)"}]}