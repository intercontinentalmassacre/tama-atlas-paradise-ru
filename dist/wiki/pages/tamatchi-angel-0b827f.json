/static.wikia.nocookie.net/tamagotchi/images/9/9d/TamatchiAngelSprite_App2.png/revision/latest?cb=20140404032900","caption":"TamatchiAngelSprite App2.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamatchiAngelSprite_App3.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/35/TamatchiAngelSprite_App3.png/revision/latest?cb=20140404032912","caption":"TamatchiAngelSprite App3.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamatchiAngel_Sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/TamatchiAngel_Sprite.png/revision/latest?cb=20140404152201","caption":"TamatchiAngel Sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamatchiAngel_2024_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/TamatchiAngel_2024_sprite.png/revision/latest?cb=20250529145710","caption":"TamatchiAngel 2024 sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamatchiAngel_sprite_SNES.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b3/TamatchiAngel_sprite_SNES.png/revision/latest?cb=20160202025513","caption":"TamatchiAngel sprite SNES.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamatchiAngelSprite_App1.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0e/TamatchiAngelSprite_App1.png/revision/latest?cb=20140404032848","caption":"TamatchiAngelSprite App1.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiParkTamatchiAngel.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/43/TamagotchiParkTamatchiAngel.png/revision/latest?cb=20230711013708","caption":"TamagotchiParkTamatchiAngel.png"}],"related":[{"id":"tamagotchi-angel-f944e3","title":"Tamagotchi Angel","ru":"Tamagotchi Angel","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"}]}