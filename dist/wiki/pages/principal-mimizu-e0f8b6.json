},{"file":"https://tamagotchi.fandom.com/wiki/File:Gn155456.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/9c/Gn155456.jpg/revision/latest/scale-to-width-down/320?cb=20230929234755","caption":"Безумный Шляпник Мимидзу","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/9c/Gn155456.jpg/revision/latest?cb=20230929234755"},{"file":"https://tamagotchi.fandom.com/wiki/File:PrincipalMimizu_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/c4/PrincipalMimizu_sprite.png/revision/latest?cb=20141026045101","caption":"Игровой спрайт · Principal Mimizu","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:PrincipalMimizu_iDL_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e6/PrincipalMimizu_iDL_sprite.png/revision/latest?cb=20260313220048","caption":"Игровой спрайт · Principal Mimizu","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Mimizu4USprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/da/Mimizu4USprite.png/revision/latest?cb=20220719042945","caption":"Игровой спрайт · Principal Mimizu","sprite":true}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC), загружаемый контент"}]}