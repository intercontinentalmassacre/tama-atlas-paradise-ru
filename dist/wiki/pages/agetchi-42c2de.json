.net/tamagotchi/images/a/a9/Spacytchi_blue_large.png/revision/latest/scale-to-width-down/320?cb=20110910102108","caption":"Современная версия","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a9/Spacytchi_blue_large.png/revision/latest?cb=20110910102108"},{"file":"https://tamagotchi.fandom.com/wiki/File:Necktietchi_blue_small.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/06/Necktietchi_blue_small.PNG/revision/latest/scale-to-width-down/320?cb=20200818164756","caption":"Современная версия","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/06/Necktietchi_blue_small.PNG/revision/latest?cb=20200818164756"}],"related":[{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""}]}