s/b/b5/403299_original.jpg/revision/latest?cb=20160105023600"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-10-27_09-04-22-784.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/cf/Bandicam_2018-10-27_09-04-22-784.jpg/revision/latest/scale-to-width-down/320?cb=20181027130443","caption":"Bandicam 2018-10-27 09-04-22-784.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/cf/Bandicam_2018-10-27_09-04-22-784.jpg/revision/latest?cb=20181027130443"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-18_13-03-13-252.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/8b/Bandicam_2019-06-18_13-03-13-252.png/revision/latest/scale-to-width-down/320?cb=20190618170603","caption":"Bandicam 2019-06-18 13-03-13-252.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/8b/Bandicam_2019-06-18_13-03-13-252.png/revision/latest?cb=20190618170603"},{"file":"https://tamagotchi.fandom.com/wiki/File:RedLantern.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/ce/RedLantern.jpeg/revision/latest/scale-to-width-down/320?cb=20221107134352","caption":"Красный Фонарь","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/ce/RedLantern.jpeg/revision/latest?cb=20221107134352"},{"file":"https://tamagotchi.fandom.com/wiki/File:Mr._turtlepedia_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/43/Mr._turtlepedia_sprite.png/revision/latest?cb=20210515063315","caption":"Mr. turtlepedia sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MrTurtlepediaIDLSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b6/MrTurtlepediaIDLSprite.png/revision/latest?cb=20241111230646","caption":"MrTurtlepediaIDLSprite.png","sprite":true}],"related":[{"id":"chou-jinsei-enjoi-tamagotchi-plus-7ac1c9","title":"Chou Jinsei Enjoi Tamagotchi Plus","ru":"Chou Jinsei Enjoi Tamagotchi Plus","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-connection-version-4-ad1b87","title":"Tamagotchi Connection Version 4","ru":"Tamagotchi Connection Version 4","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-connection-version-4-5-04b989","title":"Tamagotchi Connection Version 4.5","ru":"Tamagotchi Connection Version 4.5","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-plus-color-87834e","title":"Tamagotchi Plus Color","ru":"Tamagotchi Plus Color","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"}]}