idth-down/320?cb=20181025001253","caption":"Bandicam 2018-10-14 20-00-26-456.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/34/Bandicam_2018-10-14_20-00-26-456.jpg/revision/latest?cb=20181025001253"},{"src":"gallery-assets/img/1e/1e52d89b518184adf3b9.webp","file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2020-03-28_19-23-12-754.png","caption":"Кадр · Sebiretchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:14_%E3%81%BB%E3%82%8F%E3%81%84%E3%81%A3%E3%81%A1.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/14_%E3%81%BB%E3%82%8F%E3%81%84%E3%81%A3%E3%81%A1.gif/revision/latest?cb=20110918210600","caption":"14 ほわいっち.gif"}],"related":[]}