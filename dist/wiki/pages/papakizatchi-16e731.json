b=20220816020803"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-08-31_16-05-09-782.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/Bandicam_2018-08-31_16-05-09-782.jpg/revision/latest/scale-to-width-down/320?cb=20180908160626","caption":"Снимок экрана · Папакизатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/Bandicam_2018-08-31_16-05-09-782.jpg/revision/latest?cb=20180908160626"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-09-29_11-05-03-646.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/Bandicam_2018-09-29_11-05-03-646.jpg/revision/latest/scale-to-width-down/320?cb=20180929150836","caption":"Снимок экрана · Папакизатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/Bandicam_2018-09-29_11-05-03-646.jpg/revision/latest?cb=20180929150836"},{"src":"gallery-assets/img/9e/9ebe0331fd66bc37418f.webp","file":"https://tamagotchi.fandom.com/wiki/File:0075.jpg","caption":"Брелок Violet Family плюшевый"},{"file":"https://tamagotchi.fandom.com/wiki/File:Papakizatchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a0/Papakizatchi_sprite.png/revision/latest?cb=20140810010637","caption":"Игровой спрайт · Папакизатчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:PapakizunatchiOnSprite.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0b/PapakizunatchiOnSprite.PNG/revision/latest?cb=20250324164534","caption":"Игровой спрайт · Папакизатчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Mamavioletchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b5/Mamavioletchi.PNG/revision/latest?cb=20250427164406","caption":"Современная версия"},{"file":"https://tamagotchi.fandom.com/wiki/File:Violetchi_blue.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/Violetchi_blue.PNG/revision/latest/scale-to-width-down/320?cb=20200825162733","caption":"На изображении · Виолетчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/Violetchi_blue.PNG/revision/latest?cb=20200825162733"},{"file":"https://tamagotchi.fandom.com/wiki/File:Kizatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/39/Kizatchi.png/revision/latest/scale-to-width-down/320?cb=20210628020111","caption":"На изображении · Кизатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/39/Kizatchi.png/revision/latest?cb=20210628020111"},{"file":"https://tamagotchi.fandom.com/wiki/File:Hanatarezotchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/df/Hanatarezotchi.png/revision/latest/scale-to-width-down/320?cb=20140701022146","caption":"Из альбома «Папакизатчи» · № 25","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/df/Hanatarezotchi.png/revision/latest?cb=20140701022146"},{"file":"https://tamagotchi.fandom.com/wiki/File:Papakizatchi_no_bg.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/6d/Papakizatchi_no_bg.png/revision/latest?cb=20140830235936","caption":"На изображении · Папакизатчи"}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}