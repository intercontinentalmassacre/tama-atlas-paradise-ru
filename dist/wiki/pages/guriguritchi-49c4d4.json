0214003823","caption":"Наклейки Онсэн-Сайко Тамамори","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/25/TamamoriOnsenSaikou.jpg/revision/latest?cb=20230214003823"},{"file":"https://tamagotchi.fandom.com/wiki/File:GuriguritchiIDLSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/75/GuriguritchiIDLSprite.png/revision/latest?cb=20220821012536","caption":"Игровой спрайт · Гуригуритчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:GuriguritchiMixSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7e/GuriguritchiMixSprite.png/revision/latest?cb=20220713172315","caption":"Игровой спрайт · Гуригуритчи","sprite":true}],"related":[{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}