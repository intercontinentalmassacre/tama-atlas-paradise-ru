terflytchi_figure_in_package.jpg/revision/latest?cb=20140714051749"},{"file":"https://tamagotchi.fandom.com/wiki/File:PsChapitchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a5/PsChapitchi.png/revision/latest?cb=20210917052638","caption":"На изображении · Чапитчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:YellowChapitchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/YellowChapitchi.PNG/revision/latest?cb=20210802190421","caption":"На изображении · Чапитчи"}],"related":[{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":""},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""}]}