net/tamagotchi/images/e/e3/Keitai_2pack_Winter.jpg/revision/latest?cb=20180925055654"},{"file":"https://tamagotchi.fandom.com/wiki/File:Keitai_MetalBlue.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/Keitai_MetalBlue.jpg/revision/latest/scale-to-width-down/320?cb=20210626172106","caption":"Keitai MetalBlue.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/Keitai_MetalBlue.jpg/revision/latest?cb=20210626172106"},{"file":"https://tamagotchi.fandom.com/wiki/File:Keitai_MetalPink.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/bd/Keitai_MetalPink.jpg/revision/latest/scale-to-width-down/320?cb=20210626172121","caption":"Keitai MetalPink.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/b/bd/Keitai_MetalPink.jpg/revision/latest?cb=20210626172121"},{"file":"https://tamagotchi.fandom.com/wiki/File:Keitai_MilkTea.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/14/Keitai_MilkTea.jpg/revision/latest/scale-to-width-down/320?cb=20180925055801","caption":"Keitai MilkTea.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/14/Keitai_MilkTea.jpg/revision/latest?cb=20180925055801"},{"file":"https://tamagotchi.fandom.com/wiki/File:Keitai_Chocolate.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/68/Keitai_Chocolate.jpg/revision/latest/scale-to-width-down/320?cb=20180925055817","caption":"Keitai Chocolate.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/68/Keitai_Chocolate.jpg/revision/latest?cb=20180925055817"},{"file":"https://tamagotchi.fandom.com/wiki/File:Keitai_Flowering.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7c/Keitai_Flowering.jpg/revision/latest/scale-to-width-down/320?cb=20180925055828","caption":"Keitai Flowering.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7c/Keitai_Flowering.jpg/revision/latest?cb=20180925055828"},{"file":"https://tamagotchi.fandom.com/wiki/File:Ke