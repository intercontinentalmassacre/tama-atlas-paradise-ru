chi.fandom.com/wiki/File:PukatchiPoliceOfficer.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/bf/PukatchiPoliceOfficer.jpeg/revision/latest/scale-to-width-down/320?cb=20221027002823","caption":"Pukatchi Офицер полиции","large":"https://static.wikia.nocookie.net/tamagotchi/images/b/bf/PukatchiPoliceOfficer.jpeg/revision/latest?cb=20221027002823"},{"src":"gallery-assets/img/93/93fe031575bf0c2dd9ad.webp","file":"https://tamagotchi.fandom.com/wiki/File:ForestDoll.jpeg","caption":"Лесная кукла"},{"src":"gallery-assets/img/c8/c85d414fa3500fbe09aa.webp","file":"https://tamagotchi.fandom.com/wiki/File:Card_TMGC01-017.jpg","caption":"Карта 017"},{"file":"https://tamagotchi.fandom.com/wiki/File:2372.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b6/2372.jpg/revision/latest?cb=20120330053951","caption":"2372.jpg"},{"file":"https://tamagotchi.fandom.com/wiki/File:20060830_67391.JPG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f7/20060830_67391.JPG/revision/latest?cb=20181112223151","caption":"Плюш Pukatchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:Pukatchi_v4_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/df/Pukatchi_v4_sprite.png/revision/latest?cb=20240909190845","caption":"Pukatchi v4 sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Pukatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e5/Pukatchi.png/revision/latest/scale-to-width-down/320?cb=20210403062139","caption":"Pukatchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/e5/Pukatchi.png/revision/latest?cb=20210403062139"}],"related":[{"id":"chou-jinsei-enjoi-tamagotchi-plus-7ac1c9","title":"Chou Jinsei Enjoi Tamagotchi Plus","ru":"Chou Jinsei Enjoi Tamagotchi Plus","kind":"device","note":""},{"id":"tamatown-tama-go-ef5dce","title":"TamaTown Tama-Go","ru":"TamaTown Tama-Go","kind":"device","note":""},{"id":"tamagotchi-connection-version-4-ad1b87","ti