NESchars.png","caption":"Игра «Налево или направо»","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:QCHAR.BIN(1394)_p00.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3f/QCHAR.BIN%281394%29_p00.png/revision/latest?cb=20210205003235","caption":"Из альбома «Twin Angels» · № 21"},{"file":"https://tamagotchi.fandom.com/wiki/File:TwinAngelsSprite_App2.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a3/TwinAngelsSprite_App2.png/revision/latest?cb=20140329111645","caption":"Игровой спрайт · Twin Angels","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:TwinAngelsSprite_App3.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/TwinAngelsSprite_App3.png/revision/latest?cb=20140329111655","caption":"Игровой спрайт · Twin Angels","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Angel_Balloons_Uni_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/Angel_Balloons_Uni_sprite.png/revision/latest?cb=20240702175045","caption":"Аксессуар Angel Balloons (Уни)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:AngelCybies.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/19/AngelCybies.jpg/revision/latest/scale-to-width-down/320?cb=20140310151814","caption":"Киби плюшевые","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/19/AngelCybies.jpg/revision/latest?cb=20140310151814"},{"src":"gallery-assets/img/8f/8faccbf48b11daa9a4f3.webp","file":"https://tamagotchi.fandom.com/wiki/File:Gashapon_Tamagotchi_Sticks_Together_8_Character.jpg","caption":"Наклейки гачапон"},{"file":"https://tamagotchi.fandom.com/wiki/File:TenshitchiMug.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/TenshitchiMug.png/revision/latest/scale-to-width-down/320?cb=20230227025349","caption":"Кружка","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5c/TenshitchiMug.png/revision/latest?cb=20230227025349"},{"f