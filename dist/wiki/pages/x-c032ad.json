m/wiki/File:XPsSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/63/XPsSprite.png/revision/latest?cb=20220819051834","caption":"XPsSprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:SmartotchiModern.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/SmartotchiModern.png/revision/latest/scale-to-width-down/320?cb=20200908051435","caption":"SmartotchiModern.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/SmartotchiModern.png/revision/latest?cb=20200908051435"}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"камео"}]}