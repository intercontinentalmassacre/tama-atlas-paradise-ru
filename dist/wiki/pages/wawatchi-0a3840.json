.wikia.nocookie.net/tamagotchi/images/8/89/WawatchiSamArtwork.png/revision/latest/scale-to-width-down/320?cb=20220513174626","caption":"Иллюстрация · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/89/WawatchiSamArtwork.png/revision/latest?cb=20220513174626"},{"file":"https://tamagotchi.fandom.com/wiki/File:OctopusWawatchiArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/OctopusWawatchiArtwork.png/revision/latest/scale-to-width-down/320?cb=20221028041909","caption":"Иллюстрация · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/OctopusWawatchiArtwork.png/revision/latest?cb=20221028041909"},{"file":"https://tamagotchi.fandom.com/wiki/File:JinbeiWawatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b6/JinbeiWawatchi.png/revision/latest/scale-to-width-down/320?cb=20220615184040","caption":"На изображении · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/b/b6/JinbeiWawatchi.png/revision/latest?cb=20220615184040"},{"file":"https://tamagotchi.fandom.com/wiki/File:TreasureWowArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5f/TreasureWowArtwork.png/revision/latest/scale-to-width-down/320?cb=20221028051938","caption":"Иллюстрация · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5f/TreasureWowArtwork.png/revision/latest?cb=20221028051938"},{"file":"https://tamagotchi.fandom.com/wiki/File:WawaFortune.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3a/WawaFortune.png/revision/latest/scale-to-width-down/320?cb=20221029044751","caption":"Из альбома «Ваватчи» · № 34","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/3a/WawaFortune.png/revision/latest?cb=20221029044751"},{"file":"https://tamagotchi.fandom.com/wiki/File:JoyWawatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/JoyWawatchi.png/revision/latest/scale-to-width-down/320?cb=20221124054137","caption":"На изображении · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/JoyWawatchi.png/revision/latest?cb=20221124054137"},{"file":"https://tamagotchi.fandom.com/wiki/File:Wawatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/Wawatchi.png/revision/latest/scale-to-width-down/320?cb=20210619173313","caption":"Портрет · Ваватчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/82/Wawatchi.png/revision/latest?cb=20210619173313"}],"related":[{"id":"tamagotchi-nano-colorful-mametchi-memories-c351a3","title":"Tamagotchi Nano Colorful: Mametchi Memories","ru":"Tamagotchi Nano Colorful: Mametchi Memories","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":""},{"id":"tamagotchi-smart-ed1a78","title":"Tamagotchi Smart","ru":"Tamagotchi Smart","kind":"device","note":""}]}