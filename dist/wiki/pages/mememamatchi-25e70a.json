mamatchi_crying.png/revision/latest/scale-to-width-down/320?cb=20141103035825","caption":"Mamametchi mememamatchi crying.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/51/Mamametchi_mememamatchi_crying.png/revision/latest?cb=20141103035825"},{"file":"https://tamagotchi.fandom.com/wiki/File:HSU_CelebriaVisit4.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/62/HSU_CelebriaVisit4.PNG/revision/latest/scale-to-width-down/320?cb=20211016214952","caption":"HSU CelebriaVisit4.PNG","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/62/HSU_CelebriaVisit4.PNG/revision/latest?cb=20211016214952"},{"file":"https://tamagotchi.fandom.com/wiki/File:HSU_Tornado12.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/66/HSU_Tornado12.PNG/revision/latest/scale-to-width-down/320?cb=20211017055632","caption":"HSU Tornado12.PNG","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/66/HSU_Tornado12.PNG/revision/latest?cb=20211017055632"},{"file":"https://tamagotchi.fandom.com/wiki/File:HSU_StoryEnd5.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/6c/HSU_StoryEnd5.PNG/revision/latest/scale-to-width-down/320?cb=20211017060923","caption":"HSU StoryEnd5.PNG","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/6c/HSU_StoryEnd5.PNG/revision/latest?cb=20211017060923"},{"file":"https://tamagotchi.fandom.com/wiki/File:HSU_Saved11.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/HSU_Saved11.PNG/revision/latest/scale-to-width-down/320?cb=20211017061849","caption":"HSU Saved11.PNG","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/HSU_Saved11.PNG/revision/latest?cb=20211017061849"},{"file":"https://tamagotchi.fandom.com/wiki/File:EP_009.mp4_001439771.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a3/EP_009.mp4_001439771.png/revision/latest/scale-to-width-down/320?cb=20220602160428","caption":"EP 009.mp4 001439771.png","large":"https