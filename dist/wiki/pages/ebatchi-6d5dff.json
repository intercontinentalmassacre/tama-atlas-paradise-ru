//tamagotchi.fandom.com/wiki/File:Ebatchi_sprites.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5b/Ebatchi_sprites.png/revision/latest?cb=20251219224842","caption":"Спрайт меню (My Tamagotchi Forever)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:13_%E3%81%88%E3%81%B0%E3%81%A3%E3%81%A1.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/be/13_%E3%81%88%E3%81%B0%E3%81%A3%E3%81%A1.gif/revision/latest?cb=20110918210600","caption":"GIF из альбома «Эбатчи»"}],"related":[]}