.com/wiki/File:Bandicam_2020-04-28_00-40-33-114.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/7d/Bandicam_2020-04-28_00-40-33-114.png/revision/latest/scale-to-width-down/320?cb=20200509223456","caption":"Bandicam 2020-04-28 00-40-33-114.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/7d/Bandicam_2020-04-28_00-40-33-114.png/revision/latest?cb=20200509223456"},{"file":"https://tamagotchi.fandom.com/wiki/File:4f3dd713.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/2f/4f3dd713.jpg/revision/latest/scale-to-width-down/320?cb=20201028201518","caption":"4f3dd713.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/2f/4f3dd713.jpg/revision/latest?cb=20201028201518"},{"file":"https://tamagotchi.fandom.com/wiki/File:EP_150_0001148049ms.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e3/EP_150_0001148049ms.png/revision/latest/scale-to-width-down/320?cb=20211228090346","caption":"Тропикачи был убит током","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/e3/EP_150_0001148049ms.png/revision/latest?cb=20211228090346"},{"file":"https://tamagotchi.fandom.com/wiki/File:FuriFuritchi_close_up_ii.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/FuriFuritchi_close_up_ii.png/revision/latest/scale-to-width-down/320?cb=20210906001754","caption":"Закрыть Furifuritchi и Julietchi","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/FuriFuritchi_close_up_ii.png/revision/latest?cb=20210906001754"},{"file":"https://tamagotchi.fandom.com/wiki/File:Tropicatchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/42/Tropicatchi_sprite.png/revision/latest?cb=20150117054149","caption":"Tropicatchi sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Tropicatchisprite4U.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/98/Tropicatchisprite4U.png/revision/latest?cb=20150718200753","caption":"Tropicatchisprite4U.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Tropicatchimix.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b4/Tropicatchimix.png/revision/latest?cb=20180625031922","caption":"Tropicatchimix.png"}],"related":[{"id":"tamagotchi-4u-e5ac81","title":"Tamagotchi 4U","ru":"Tamagotchi 4U","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-4u-bcca85","title":"Tamagotchi 4U+","ru":"Tamagotchi 4U+","kind":"device","note":"загружаемый контент"},{"id":"tamagotchi-friends-fe748c","title":"Tamagotchi Friends","ru":"Tamagotchi Friends","kind":"device","note":""},{"id":"tamagotchi-friends-dream-town-digital-friend-bf6100","title":"Tamagotchi Friends: Dream Town Digital Friend","ru":"Tamagotchi Friends: Dream Town Digital Friend","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}