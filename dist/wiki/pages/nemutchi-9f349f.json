.wikia.nocookie.net/tamagotchi/images/5/56/Bandicam_2018-09-22_15-57-25-357.jpg/revision/latest/scale-to-width-down/320?cb=20181206235234","caption":"Снимок экрана · Нэмутчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/56/Bandicam_2018-09-22_15-57-25-357.jpg/revision/latest?cb=20181206235234"},{"file":"https://tamagotchi.fandom.com/wiki/File:S1E23GreatChocolateStanding.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5a/S1E23GreatChocolateStanding.PNG/revision/latest/scale-to-width-down/320?cb=20210619060610","caption":"Сезон 1, серия 23","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5a/S1E23GreatChocolateStanding.PNG/revision/latest?cb=20210619060610"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-08-04_23-55-09-723.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/c7/Bandicam_2018-08-04_23-55-09-723.jpg/revision/latest/scale-to-width-down/320?cb=20180805050403","caption":"Снимок экрана · Нэмутчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/c7/Bandicam_2018-08-04_23-55-09-723.jpg/revision/latest?cb=20180805050403"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-08-04_23-45-57-518.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/31/Bandicam_2018-08-04_23-45-57-518.jpg/revision/latest/scale-to-width-down/320?cb=20180805050347","caption":"Снимок экрана · Нэмутчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/31/Bandicam_2018-08-04_23-45-57-518.jpg/revision/latest?cb=20180805050347"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-07-30_23-34-58-536.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a5/Bandicam_2018-07-30_23-34-58-536.jpg/revision/latest/scale-to-width-down/320?cb=20180731035749","caption":"Снимок экрана · Нэмутчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a5/Bandicam_2018-07-30_23-34-58-536.jpg/revision/latest?cb=20180731035749"},{"file"