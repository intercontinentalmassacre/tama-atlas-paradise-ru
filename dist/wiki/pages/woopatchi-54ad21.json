iki/File:TamagotchiPortalWebsiteArtwork.jpg","caption":"Tamagotchi Баннер веб-сайта"},{"src":"gallery-assets/img/bd/bdee6608319a997ea2db.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiUniXSanrioCharactersFullCollabArtwork.png","caption":"Tamagotchi Uni X Санрио"},{"src":"gallery-assets/img/6a/6a6badd30b1d4fe51a56.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiUniAngelMonsterBanner.jpg","caption":"Tamagotchi Uni Баннер с объявлением «Ангел и монстр»"},{"src":"gallery-assets/img/e4/e4dac5134467064228e0.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiMonsterBanner.jpg","caption":"Персонажи Карнавала монстров"},{"src":"gallery-assets/img/ee/ee59f9719075c7fb87c4.webp","file":"https://tamagotchi.fandom.com/wiki/File:OpaViVereForusCollabArtwork.jpg","caption":"Tamagotchi Промо-акция мероприятия X Opa Vivre Forus"},{"src":"gallery-assets/img/b8/b85c8322e3b6b4bb79cf.webp","file":"https://tamagotchi.fandom.com/wiki/File:Tamagotchi30thAnniversary_ArtBanner.png","caption":"Баннер к 30-летию Tamagotchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:Cogimyun_Woopatchi_Sprite_-_Sanrio.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/74/Cogimyun_Woopatchi_Sprite_-_Sanrio.png/revision/latest?cb=20240817164345","caption":"Когимюн Вупатчи (Уни)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Meduupa_Uni_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/fe/Meduupa_Uni_sprite.png/revision/latest?cb=20240801164005","caption":"Медуупа (Уни)","sprite":true},{"src":"gallery-assets/img/93/934a750a462bdfbcd8f1.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamagotchiUni_lanyard_black.jpg","caption":"Чёрный ремешок для Tamagotchi Uni"},{"file":"https://tamagotchi.fandom.com/wiki/File:WorldTamaTourFlagSticker.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/25/WorldTamaTourFlagSticker.png/revision/latest?cb=20230701031123","caption":"Наклейка World Tama Tour"},{"src":"gallery-assets/img/a9/a9c4c6e903603092ac18.webp","file":"https://tamagotchi.fandom.com/wiki/File:YodobashiCameraUniSticker.png","caption":"Наклейка Yodobashi Camera Tama"},{"file":"https://tamagotchi.fandom.com/wiki/File:AeonSticker.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/AeonSticker.png/revision/latest/scale-to-width-down/320?cb=20231121052338","caption":"Наклейка Эон Тама","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/AeonSticker.png/revision/latest?cb=20231121052338"},{"file":"https://tamagotchi.fandom.com/wiki/File:WoopatchiUniSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/79/WoopatchiUniSprite.png/revision/latest?cb=20230707095202","caption":"Игровой спрайт · Вупатчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:CogimyunWoopatchiArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0e/CogimyunWoopatchiArtwork.png/revision/latest/scale-to-width-down/320?cb=20250220171633","caption":"Иллюстрация · Вупатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0e/CogimyunWoopatchiArtwork.png/revision/latest?cb=20250220171633"},{"file":"https://tamagotchi.fandom.com/wiki/File:MeduupaArtwork.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/2d/MeduupaArtwork.png/revision/latest/scale-to-width-down/320?cb=20240605055846","caption":"Иллюстрация · Вупатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/2d/MeduupaArtwork.png/revision/latest?cb=20240605055846"},{"file":"https://tamagotchi.fandom.com/wiki/File:Woopatchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/37/Woopatchi.png/revision/latest/scale-to-width-down/320?cb=20230607110321","caption":"Портрет · Вупатчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/37/Woopatchi.png/revision/latest?cb=20230607110321"}],"related":[{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni"