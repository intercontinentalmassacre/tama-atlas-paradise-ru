.fandom.com/wiki/File:Gg919042.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/62/Gg919042.jpg/revision/latest/scale-to-width-down/320?cb=20230919174306","caption":"Otogitchi (Брат)","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/62/Gg919042.jpg/revision/latest?cb=20230919174306"},{"file":"https://tamagotchi.fandom.com/wiki/File:Gg919033.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e9/Gg919033.jpg/revision/latest/scale-to-width-down/320?cb=20230919174456","caption":"Otogitchi (Брат) играет на музыкальных инструментах","large":"https://static.wikia.nocookie.net/tamagotchi/images/e/e9/Gg919033.jpg/revision/latest?cb=20230919174456"},{"file":"https://tamagotchi.fandom.com/wiki/File:Carddass_Fairytale_O16.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3d/Carddass_Fairytale_O16.jpg/revision/latest/scale-to-width-down/320?cb=20260110160745","caption":"На изображении · Fairy","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/3d/Carddass_Fairytale_O16.jpg/revision/latest?cb=20260110160745"},{"file":"https://tamagotchi.fandom.com/wiki/File:Carddass_Fairytale_A11.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d1/Carddass_Fairytale_A11.jpg/revision/latest/scale-to-width-down/320?cb=20260110160743","caption":"На изображении · Fairy","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d1/Carddass_Fairytale_A11.jpg/revision/latest?cb=20260110160743"},{"file":"https://tamagotchi.fandom.com/wiki/File:MLibraryShip.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f9/MLibraryShip.png/revision/latest?cb=20230328043941","caption":"Вход в волшебный летающий корабль-библиотеку (вкл.)"},{"file":"https://tamagotchi.fandom.com/wiki/File:PictureBook_Uni_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/51/PictureBook_Uni_sprite.png/revision/latest?cb=20241202163714","caption":"Элемент книжки с картинками (Университет)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:PapaOtogitchi_Meets_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/6b/PapaOtogitchi_Meets_sprite.png/revision/latest?cb=20250501203332","caption":"Отец Brother Otogitchi и Sister Otogitchi (m!x и Meets)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MamaOtogitchi_Meets_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e0/MamaOtogitchi_Meets_sprite.png/revision/latest?cb=20250501203354","caption":"Мать Brother Otogitchi и Sister Otogitchi (m!x и Meets)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Otogitchi_%2BC_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/4d/Otogitchi_%2BC_sprite.png/revision/latest?cb=20241111230927","caption":"Игровой спрайт · Отогитчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Otogitchi15th.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/32/Otogitchi15th.png/revision/latest?cb=20160528142441","caption":"На изображении · Отогитчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:Otogitchi_mix.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/22/Otogitchi_mix.png/revision/latest?cb=20160922170828","caption":"На изображении · Отогитчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:SisterOtogitchiBlue.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/93/SisterOtogitchiBlue.png/revision/latest?cb=20221219114907","caption":"Современная версия"}],"related":[{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-plus-color-87834e","title":"Tamagotchi Plus Color","ru":"Tamagotchi Plus Color","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}