:"Краснеет"},{"file":"https://tamagotchi.fandom.com/wiki/File:IDLUraFlowertchiSleep.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/45/IDLUraFlowertchiSleep.png/revision/latest?cb=20230626001537","caption":"Спит"},{"file":"https://tamagotchi.fandom.com/wiki/File:IDLUraFlowertchiKiss.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/96/IDLUraFlowertchiKiss.png/revision/latest?cb=20230626001537","caption":"Целуется"},{"file":"https://tamagotchi.fandom.com/wiki/File:IDLUraFlowertchiCloseup.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/13/IDLUraFlowertchiCloseup.gif/revision/latest?cb=20230626001530","caption":"Крупный план"},{"file":"https://tamagotchi.fandom.com/wiki/File:M863115966_1.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/M863115966_1.jpg/revision/latest/scale-to-width-down/320?cb=20181018022707","caption":"Плюш Ура Флауэртчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/47/M863115966_1.jpg/revision/latest?cb=20181018022707"},{"file":"https://tamagotchi.fandom.com/wiki/File:Ura_violetchi_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/52/Ura_violetchi_sprite.png/revision/latest?cb=20141207175917","caption":"Игровой спрайт · Ura Violetchi","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:UraVioletchi_V4.5_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/31/UraVioletchi_V4.5_sprite.png/revision/latest?cb=20240819194257","caption":"Игровой спрайт · Ura Violetchi","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Ura_Violetchi15th.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/ce/Ura_Violetchi15th.png/revision/latest?cb=20260915144932","caption":"На изображении · Виолетчи"},{"file":"https://tamagotchi.fandom.com/wiki/File:UraFurawatchi_MametchiMemories_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/ff/UraFurawatchi_MametchiMemories_sprite.png/revision/latest?cb=20261007152222","caption":"Игровой спрайт · Ura Violetchi","sprite":true}],"related":[{"id":"tamagotchi-connection-version-4-5-04b989","title":"Tamagotchi Connection Version 4.5","ru":"Tamagotchi Connection Version 4.5","kind":"device","note":""},{"id":"tamagotchi-nano-colorful-mametchi-memories-c351a3","title":"Tamagotchi Nano Colorful: Mametchi Memories","ru":"Tamagotchi Nano Colorful: Mametchi Memories","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""},{"id":"ura-jinsei-enjoi-tamagotchi-plus-68a64c","title":"Ura Jinsei Enjoi Tamagotchi Plus","ru":"Ura Jinsei Enjoi Tamagotchi Plus","kind":"device","note":""}]}