.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/39/Kizatchi.png/revision/latest/scale-to-width-down/320?cb=20210628020111","caption":"Kizatchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/3/39/Kizatchi.png/revision/latest?cb=20210628020111"}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""}]}