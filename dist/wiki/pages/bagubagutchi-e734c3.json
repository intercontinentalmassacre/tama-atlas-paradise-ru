ote":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/Egg_family.png/revision/latest/scale-to-width-down/320?cb=20220626103632","caption":"Egg family.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/4/41/Egg_family.png/revision/latest?cb=20220626103632"},{"file":"https://tamagotchi.fandom.com/wiki/File:Tv1346061964956.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/af/Tv1346061964956.jpg/revision/latest/scale-to-width-down/320?cb=20120827111039","caption":"Tv1346061964956.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/af/Tv1346061964956.jpg/revision/latest?cb=20120827111039"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bagubagutchi-Mario_Kart_Arcade_GP_2.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/ce/Bagubagutchi-Mario_Kart_Arcade_GP_2.png/revision/latest/scale-to-width-down/320?cb=20180922221738","caption":"Модель Bagubagutchi в Mario Kart Arcade GP 2","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/ce/Bagubagutchi-Mario_Kart_Arcade_GP_2.png/revision/latest?cb=20180922221738"},{"file":"https://tamagotchi.fandom.com/wiki/File:Hokkari_bagubagutchi.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/93/Hokkari_bagubagutchi.png/revision/latest?cb=20240705132610","caption":"Hokkari bagubagutchi.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:Snow_bagubagutchi_card.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0a/Snow_bagubagutchi_card.jpg/revision/latest/scale-to-width-down/320?cb=20240705133037","caption":"Карточка снежного наряда","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0a/Snow_bagubagutchi_card.jpg/revision/latest?cb=20240705133037"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bagubagutchi_card.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f0/Bagubagutchi_card.jpg/revision/latest/scale-to-width-down/320?cb=20240705133021","caption":"Карточка китайской экипировки","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f0/Bagubagutchi_card.jpg/revision/latest?cb=20240705133021"},{"src":"gallery-assets/img/e6/e605115301b71c38aa20.webp","file":"https://tamagotchi.fandom.com/wiki/File:Mame_house2.jpg","caption":"Домашний игровой набор Mametchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bagubagutchi_v5.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/5/5a/Bagubagutchi_v5.PNG/revision/latest?cb=20110910001647","caption":"Bagubagutchi v5.PNG"},{"file":"https://tamagotchi.fandom.com/wiki/File:BagubagutchiIDLSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/9f/BagubagutchiIDLSprite.png/revision/latest?cb=20220821012536","caption":"BagubagutchiIDLSprite.png","sprite":true}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":""},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":""}]}