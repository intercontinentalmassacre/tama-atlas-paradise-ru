=20260927004553","caption":"Справочный лист","large":"https://static.wikia.nocookie.net/tamagotchi/images/5/5d/Shirimotchi_reference.png/revision/latest?cb=20260927004553"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2020-04-03_15-34-41-728.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/10/Bandicam_2020-04-03_15-34-41-728.png/revision/latest/scale-to-width-down/320?cb=20200413162528","caption":"Bandicam 2020-04-03 15-34-41-728.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/10/Bandicam_2020-04-03_15-34-41-728.png/revision/latest?cb=20200413162528"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2020-04-03_15-34-49-011.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d6/Bandicam_2020-04-03_15-34-49-011.png/revision/latest/scale-to-width-down/320?cb=20200413162721","caption":"Bandicam 2020-04-03 15-34-49-011.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d6/Bandicam_2020-04-03_15-34-49-011.png/revision/latest?cb=20200413162721"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2020-04-03_15-37-08-232.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/Bandicam_2020-04-03_15-37-08-232.png/revision/latest/scale-to-width-down/320?cb=20200413162835","caption":"Bandicam 2020-04-03 15-37-08-232.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/67/Bandicam_2020-04-03_15-37-08-232.png/revision/latest?cb=20200413162835"},{"file":"https://tamagotchi.fandom.com/wiki/File:ShirimotchiInGame.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/ShirimotchiInGame.jpg/revision/latest/scale-to-width-down/320?cb=20240118051800","caption":"В Tamagotchi Королевство приключений","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/ShirimotchiInGame.jpg/revision/latest?cb=20240118051800"},{"file":"https://tamagotchi.fandom.com/wiki/File:PropellerMotchi.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/4d/PropellerMotchi.PNG/revision/latest?cb=20250527201455","caption":"Пропеллер Мотчи (P's)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Goofy.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/e5/Goofy.png/revision/latest?cb=20250527221219","caption":"Goofy Change (песня P)"},{"file":"https://tamagotchi.fandom.com/wiki/File:Shirimotchi-sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a6/Shirimotchi-sprite.png/revision/latest?cb=20130811015028","caption":"Shirimotchi-sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Shirimotchi_sprite_On.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f7/Shirimotchi_sprite_On.png/revision/latest?cb=20190820042353","caption":"Shirimotchi sprite On.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:DCShirimotchiScan.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/72/DCShirimotchiScan.png/revision/latest?cb=20210923062010","caption":"DCShirimotchiScan.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:DisCShirimotchiScan.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/8d/DisCShirimotchiScan.png/revision/latest?cb=20210925222910","caption":"DisCShirimotchiScan.png"}],"related":[{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-uni-52d523","title":"Tamagotchi Uni","ru":"Tamagotchi Uni","kind":"device","note":"гость (NPC)"}]}