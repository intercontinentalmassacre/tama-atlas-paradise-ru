tion":"Bandicam 2018-08-31 02-55-57-213.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/6/69/Bandicam_2018-08-31_02-55-57-213.jpg/revision/latest?cb=20190210102627"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-02-09_14-11-06-533.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/93/Bandicam_2019-02-09_14-11-06-533.jpg/revision/latest/scale-to-width-down/320?cb=20190209191544","caption":"Bandicam 2019-02-09 14-11-06-533.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/9/93/Bandicam_2019-02-09_14-11-06-533.jpg/revision/latest?cb=20190209191544"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2018-08-05_02-36-39-331.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/a/a3/Bandicam_2018-08-05_02-36-39-331.jpg/revision/latest/scale-to-width-down/320?cb=20240902123235","caption":"Bandicam 2018-08-05 02-36-39-331.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/a/a3/Bandicam_2018-08-05_02-36-39-331.jpg/revision/latest?cb=20240902123235"}],"related":[{"id":"tamatown-tama-go-ef5dce","title":"TamaTown Tama-Go","ru":"TamaTown Tama-Go","kind":"device","note":""},{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-music-star-89a6a2","title":"Tamagotchi Music Star","ru":"Tamagotchi Music Star","kind":"device","note":""},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-school-toy-f0c8d5","title":"Tamagotchi School (toy)","ru":"Tamagotchi School (toy)","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}