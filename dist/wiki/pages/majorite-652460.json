2.png/revision/latest/scale-to-width-down/320?cb=20190618170603","caption":"Bandicam 2019-06-18 13-03-13-252.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/8b/Bandicam_2019-06-18_13-03-13-252.png/revision/latest?cb=20190618170603"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-21_21-31-58-053.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/Bandicam_2019-06-21_21-31-58-053.png/revision/latest/scale-to-width-down/320?cb=20190622022706","caption":"Bandicam 2019-06-21 21-31-58-053.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/17/Bandicam_2019-06-21_21-31-58-053.png/revision/latest?cb=20190622022706"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-21_21-36-57-354.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/Bandicam_2019-06-21_21-36-57-354.png/revision/latest/scale-to-width-down/320?cb=20190622022751","caption":"Bandicam 2019-06-21 21-36-57-354.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/Bandicam_2019-06-21_21-36-57-354.png/revision/latest?cb=20190622022751"},{"file":"https://tamagotchi.fandom.com/wiki/File:Bandicam_2019-06-21_21-45-07-675.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/19/Bandicam_2019-06-21_21-45-07-675.png/revision/latest/scale-to-width-down/320?cb=20190622022833","caption":"Bandicam 2019-06-21 21-45-07-675.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/19/Bandicam_2019-06-21_21-45-07-675.png/revision/latest?cb=20190622022833"},{"file":"https://tamagotchi.fandom.com/wiki/File:MajoriteInGameTAK.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/c/c5/MajoriteInGameTAK.jpg/revision/latest/scale-to-width-down/320?cb=20240131062715","caption":"Появление в Tamagotchi Королевство приключений.","large":"https://static.wikia.nocookie.net/tamagotchi/images/c/c5/MajoriteInGameTAK.jpg/revision/latest?cb=20240131062715"},{"src":"gallery-assets/img/6e/6eb42611eb464c7b1e3a.webp","file":"https://tamagotchi.fandom.com/wiki/File:Tamagotchi-On_PapaMakiko_Sprites.png","caption":"Отец Makiko (m!x и On)","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:MajoriteInformationBoothGame.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0e/MajoriteInformationBoothGame.png/revision/latest/scale-to-width-down/320?cb=20251020030310","caption":"Majorite просьба к игроку о помощи в игре «Информационный стенд» на выставке Tama & Earth EXPO.","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0e/MajoriteInformationBoothGame.png/revision/latest?cb=20251020030310"},{"file":"https://tamagotchi.fandom.com/wiki/File:Majorite_sprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/9/91/Majorite_sprite.png/revision/latest?cb=20140723040124","caption":"Majorite sprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:Majorite_iD_L.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/8a/Majorite_iD_L.png/revision/latest?cb=20171205074146","caption":"Majorite iD L.png"},{"file":"https://tamagotchi.fandom.com/wiki/File:MajoriteOnSprite.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/3c/MajoriteOnSprite.PNG/revision/latest?cb=20250324154016","caption":"MajoriteOnSprite.PNG","sprite":true},{"src":"gallery-assets/img/ec/ec53e206197a4e40f323.webp","file":"https://tamagotchi.fandom.com/wiki/File:Makiko.png","caption":"Современная версия"}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}