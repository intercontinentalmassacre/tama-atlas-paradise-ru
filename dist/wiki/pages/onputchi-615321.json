.net/tamagotchi/images/1/1d/Onputchi.png/revision/latest/scale-to-width-down/320?cb=20200818161004","caption":"Onputchi.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/1/1d/Onputchi.png/revision/latest?cb=20200818161004"}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-music-star-89a6a2","title":"Tamagotchi Music Star","ru":"Tamagotchi Music Star","kind":"device","note":""}]}