ый"},{"file":"https://tamagotchi.fandom.com/wiki/File:MumutchiAnnoyed.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/60/MumutchiAnnoyed.png/revision/latest?cb=20240206064738","caption":"Раздражение"},{"file":"https://tamagotchi.fandom.com/wiki/File:MumutchiBored.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/26/MumutchiBored.png/revision/latest?cb=20240206064758","caption":"Скучно"},{"file":"https://tamagotchi.fandom.com/wiki/File:MumutchiConfident.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/46/MumutchiConfident.png/revision/latest?cb=20240206064819","caption":"Уверенно"},{"file":"https://tamagotchi.fandom.com/wiki/File:MumutchiThinking.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/45/MumutchiThinking.png/revision/latest?cb=20240206064838","caption":"мышление"},{"file":"https://tamagotchi.fandom.com/wiki/File:Screenshot_2023-02-04_174537.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/Screenshot_2023-02-04_174537.png/revision/latest/scale-to-width-down/320?cb=20230414014443","caption":"Игра Perfect Rollercoaster Image (Tama & Earth Expo)","large":"https://static.wikia.nocookie.net/tamagotchi/images/d/d0/Screenshot_2023-02-04_174537.png/revision/latest?cb=20230414014443"},{"file":"https://tamagotchi.fandom.com/wiki/File:ExpoPinballFactory.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/fb/ExpoPinballFactory.PNG/revision/latest/scale-to-width-down/320?cb=20230417043915","caption":"Игра Фабрика пинбола","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/fb/ExpoPinballFactory.PNG/revision/latest?cb=20230417043915"},{"file":"https://tamagotchi.fandom.com/wiki/File:ExpoInformationBooth.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/6/6d/ExpoInformationBooth.PNG/revision/latest/scale-to-width-down/320?cb=20230415025227","caption":"Игра «Информационный стенд»","large":"https://static.wikia.nocookie.net/tamag