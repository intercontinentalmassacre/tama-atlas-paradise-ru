утчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/73/Mumutchi.png/revision/latest?cb=20210627230516"}],"related":[{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-music-star-89a6a2","title":"Tamagotchi Music Star","ru":"Tamagotchi Music Star","kind":"device","note":"камео"}]}