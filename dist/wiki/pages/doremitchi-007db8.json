e":"https://tamagotchi.fandom.com/wiki/File:TamamoriSweetsParlor.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/70/TamamoriSweetsParlor.jpg/revision/latest/scale-to-width-down/320?cb=20230215043403","caption":"Наклейки «Салон сладостей Тамамори»","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/70/TamamoriSweetsParlor.jpg/revision/latest?cb=20230215043403"},{"src":"gallery-assets/img/28/288ecd6f04bbe60ce752.webp","file":"https://tamagotchi.fandom.com/wiki/File:TamamoriTamaPetSalon.jpg","caption":"Тама Зоосалон"},{"file":"https://tamagotchi.fandom.com/wiki/File:DoremitchiIDLSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/e/eb/DoremitchiIDLSprite.png/revision/latest?cb=20220821012536","caption":"DoremitchiIDLSprite.png","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:EP_117_0000749773ms.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/2e/EP_117_0000749773ms.png/revision/latest/scale-to-width-down/320?cb=20230209160026","caption":"EP 117 0000749773ms.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/2e/EP_117_0000749773ms.png/revision/latest?cb=20230209160026"},{"file":"https://tamagotchi.fandom.com/wiki/File:Singing_Mametchi.gif","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/23/Singing_Mametchi.gif/revision/latest/scale-to-width-down/320?cb=20221026075700","caption":"Singing Mametchi.gif","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/23/Singing_Mametchi.gif/revision/latest?cb=20221026075700"},{"file":"https://tamagotchi.fandom.com/wiki/File:EP_069.mp4_000020354.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/EP_069.mp4_000020354.png/revision/latest/scale-to-width-down/320?cb=20221026075246","caption":"EP 069.mp4 000020354.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/8/87/EP_069.mp4_000020354.png/revision/latest?cb=20221026075246"},{"file":"https://tamagotchi.fandom.com/wiki/F