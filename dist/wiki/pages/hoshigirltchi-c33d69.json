tamagotchi/images/f/f9/Prettyprincesses.jpg/revision/latest?cb=20130811025130","caption":"Prettyprincesses.jpg"},{"file":"https://tamagotchi.fandom.com/wiki/File:RCHoshigirltchiScan.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/1/18/RCHoshigirltchiScan.png/revision/latest?cb=20210922183528","caption":"RCHoshigirltchiScan.png"}],"related":[{"id":"tamagotchi-friends-fe748c","title":"Tamagotchi Friends","ru":"Tamagotchi Friends","kind":"device","note":""},{"id":"tamagotchi-friends-dream-town-digital-friend-bf6100","title":"Tamagotchi Friends: Dream Town Digital Friend","ru":"Tamagotchi Friends: Dream Town Digital Friend","kind":"device","note":""},{"id":"tamagotchi-on-24dbc2","title":"Tamagotchi On","ru":"Tamagotchi On","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":""},{"id":"tamagotchi-pix-174e73","title":"Tamagotchi Pix","ru":"Tamagotchi Pix","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}