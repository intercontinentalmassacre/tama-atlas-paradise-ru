458.203.png/revision/latest?cb=20260913135142"},{"file":"https://tamagotchi.fandom.com/wiki/File:5_Choosing_a_Dream_Class.mp4_20160219_110437.156.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0a/5_Choosing_a_Dream_Class.mp4_20160219_110437.156.png/revision/latest/scale-to-width-down/320?cb=20260913135128","caption":"5 Choosing a Dream Class.mp4 20160219 110437.156.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0a/5_Choosing_a_Dream_Class.mp4_20160219_110437.156.png/revision/latest?cb=20260913135128"},{"file":"https://tamagotchi.fandom.com/wiki/File:6_Tea_Robot.mp4_20160219_110738.125.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b2/6_Tea_Robot.mp4_20160219_110738.125.png/revision/latest/scale-to-width-down/320?cb=20260913135112","caption":"6 Tea Robot.mp4 20160219 110738.125.png","large":"https://static.wikia.nocookie.net/tamagotchi/images/b/b2/6_Tea_Robot.mp4_20160219_110738.125.png/revision/latest?cb=20260913135112"},{"file":"https://tamagotchi.fandom.com/wiki/File:1359357727-191302-001.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f2/1359357727-191302-001.jpg/revision/latest/scale-to-width-down/320?cb=20130131091652","caption":"1359357727-191302-001.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/f/f2/1359357727-191302-001.jpg/revision/latest?cb=20130131091652"},{"file":"https://tamagotchi.fandom.com/wiki/File:1353924955044.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/7/78/1353924955044.jpg/revision/latest/scale-to-width-down/320?cb=20121126113844","caption":"1353924955044.jpg","large":"https://static.wikia.nocookie.net/tamagotchi/images/7/78/1353924955044.jpg/revision/latest?cb=20121126113844"},{"file":"https://tamagotchi.fandom.com/wiki/File:MermaidStarGirl.PNG","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/32/MermaidStarGirl.PNG/revision/latest?cb=20250527200701","caption":"Девушка-русалка (P's)"},{"file":"https://