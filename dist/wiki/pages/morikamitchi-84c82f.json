atest?cb=20160105023629"},{"src":"gallery-assets/img/f3/f3ac2e4d936f07e84f8b.webp","file":"https://tamagotchi.fandom.com/wiki/File:MrKuchipatchi.jpeg","caption":"Господин Kuchipatchi"},{"file":"https://tamagotchi.fandom.com/wiki/File:StatueofMorikamitchi.jpeg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/StatueofMorikamitchi.jpeg/revision/latest/scale-to-width-down/320?cb=20221027045404","caption":"Статуя Morikamitchi","large":"https://static.wikia.nocookie.net/tamagotchi/images/0/0c/StatueofMorikamitchi.jpeg/revision/latest?cb=20221027045404"},{"file":"https://tamagotchi.fandom.com/wiki/File:SodateteTamagotchiTown_Screen2.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/f5/SodateteTamagotchiTown_Screen2.jpg/revision/latest?cb=20260131213111","caption":"На изображении · Tamago"},{"file":"https://tamagotchi.fandom.com/wiki/File:MorikamitchiInGameTAK.jpg","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/22/MorikamitchiInGameTAK.jpg/revision/latest/scale-to-width-down/320?cb=20240107051156","caption":"На изображении · Морикамитчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/22/MorikamitchiInGameTAK.jpg/revision/latest?cb=20240107051156"},{"file":"https://tamagotchi.fandom.com/wiki/File:MorikamitchiMixSprite.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/29/MorikamitchiMixSprite.png/revision/latest?cb=20220713172315","caption":"Игровой спрайт · Морикамитчи","sprite":true}],"related":[{"id":"chou-jinsei-enjoi-tamagotchi-plus-7ac1c9","title":"Chou Jinsei Enjoi Tamagotchi Plus","ru":"Chou Jinsei Enjoi Tamagotchi Plus","kind":"device","note":""},{"id":"tamagotchi-connection-version-5-dfb1d2","title":"Tamagotchi Connection Version 5","ru":"Tamagotchi Connection Version 5","kind":"device","note":""},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}