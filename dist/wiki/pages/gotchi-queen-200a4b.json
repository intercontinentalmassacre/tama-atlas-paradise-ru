ges/f/f3/Princess_Tamakoko.png/revision/latest?cb=20211219202538"},{"file":"https://tamagotchi.fandom.com/wiki/File:Mayor_tamanori.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/f/fd/Mayor_tamanori.png/revision/latest?cb=20151224004738","caption":"На изображении · Tamanori"}],"related":[{"id":"tamagotchi-connection-version-5-celebrity-071dde","title":"Tamagotchi Connection Version 5 Celebrity","ru":"Tamagotchi Connection Version 5 Celebrity","kind":"device","note":""},{"id":"tamagotchi-id-l-06561f","title":"Tamagotchi iD L","ru":"Tamagotchi iD L","kind":"device","note":"гость (NPC)"},{"id":"tamagotchi-m-x-e0c3cb","title":"Tamagotchi m!x","ru":"Tamagotchi m!x","kind":"device","note":"гость (NPC)"}]}