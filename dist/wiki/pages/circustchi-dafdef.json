tic.wikia.nocookie.net/tamagotchi/images/9/9c/Bandicam_2019-08-13_13-09-49-396.png/revision/latest?cb=20221028072406"},{"file":"https://tamagotchi.fandom.com/wiki/File:EP_161.mp4_001273138.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/2/2a/EP_161.mp4_001273138.png/revision/latest/scale-to-width-down/320?cb=20221102130907","caption":"Кадр из серии 161 · Киркустчи","large":"https://static.wikia.nocookie.net/tamagotchi/images/2/2a/EP_161.mp4_001273138.png/revision/latest?cb=20221102130907"},{"file":"https://tamagotchi.fandom.com/wiki/File:CircustchiPsSprite1.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/4/45/CircustchiPsSprite1.png/revision/latest?cb=20220819051833","caption":"Игровой спрайт · Киркустчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:CircustchiPsSprite2.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/3/32/CircustchiPsSprite2.png/revision/latest?cb=20220819051834","caption":"Игровой спрайт · Киркустчи","sprite":true},{"file":"https://tamagotchi.fandom.com/wiki/File:CircustchiPsSprite3.png","remote":"https://static.wikia.nocookie.net/tamagotchi/images/b/b5/CircustchiPsSprite3.png/revision/latest?cb=20220819051834","caption":"Игровой спрайт · Киркустчи","sprite":true}],"related":[{"id":"tamagotchi-p-s-c8135a","title":"Tamagotchi P's","ru":"Tamagotchi P's","kind":"device","note":"гость (NPC)"}]}